# Copy this file to .env.local and fill in the real values.
# For Docker Compose, place it next to docker-compose.local.yml in tutorme-app/.

# Database (used when running the app locally; Docker app uses compose env vars)
DATABASE_URL=postgresql://tutorme:tutorme_password@localhost:5433/tutorme
DIRECT_URL=postgresql://tutorme:tutorme_password@localhost:5433/tutorme

# NextAuth (required, min 32 chars)
NEXTAUTH_SECRET=change_this_to_a_random_string_with_at_least_32_characters
NEXTAUTH_URL=http://localhost:3003

# Redis (used when running the app locally; Docker app uses compose env vars)
REDIS_URL=redis://localhost:6379

# AI Provider (Kimi is the only active provider)
KIMI_API_KEY=your-kimi-api-key
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k3

# Video (optional; mock URLs are used without it)
DAILY_API_KEY=your-daily-api-key

# Payments (optional unless testing checkout)
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
HITPAY_API_KEY=
HITPAY_SALT=

# Email (optional unless testing auth emails)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
CONTACT_EMAIL=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3003
